# Example environment for the World ID Discord integration (IDKit 4).
# Copy to .env.local and fill in the remaining values. Never commit real secrets.

# App environment
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=

# Discord (application id and public key below are the public identifiers of
# the test application; the bot token and app secret are secrets)
DISCORD_APP_ID=1564151877094866944
DISCORD_APP_PUBLIC_KEY=7ac539c111a899c51d04d7840b346029fad23176d308b9e6b46bb325c137a353
DISCORD_BOT_TOKEN=
DISCORD_APP_SECRET=

# App URL
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Developer Portal (World ID 4)
NEXT_PUBLIC_APP_ID=app_
NEXT_PUBLIC_RP_ID=rp_
NEXT_PUBLIC_WORLD_ID_ENVIRONMENT=production
RP_SIGNING_KEY=
# production (default) | staging (World ID Simulator only) | sandbox
NEXT_PUBLIC_WORLD_ID_ENVIRONMENT=production
DEVELOPER_PORTAL_URL=https://developer.world.org
DEVELOPER_PORTAL_API_KEY=

# PostHog
POSTHOG_API_KEY=
POSTHOG_HOST=

# Discord integration API
# The app ships a self-hosted stand-in for the integration API (see the
# README section "Self-hosted Discord integration API"). Point the URL
# at this deployment's own origin; the /discord/* routes live at the
# app root. The sign secret authorizes the server-to-server calls.
DISCORD_INTEGRATION_API_URL=https://your-app.vercel.app
DISCORD_INTEGRATION_API_SIGN_SECRET=
# Optional: Postgres connection string for the integration API store.
# On Vercel, connecting a Neon database injects DATABASE_URL instead.
INTEGRATION_API_DATABASE_URL=
# Local development only: opt in to the single-process file/memory store.
INTEGRATION_API_ALLOW_LOCAL_STORE=true
INTEGRATION_API_STORE_FILE=
DISCORD_INTERACTION_TOKEN_SIGN_SECRET=
